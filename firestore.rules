rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDriver() {
      return isAuth() && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuth() && (request.auth.uid == studentId || isAdmin());
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.uid == studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedBusId'])
      );
      allow create, delete: if isAdmin();
    }

    // Drivers Collection
    match /drivers/{driverId} {
      allow read: if isAuth() && (request.auth.uid == driverId || isAdmin());
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.uid == driverId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBusId'])
      );
      allow create, delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAuth() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Buses Collection
    match /buses/{busId} {
      allow read: if isAuth();
      allow update: if isDriver() && (
        resource.data.currentDriverId == request.auth.uid ||
        request.resource.data.currentDriverId == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // Routes Collection
    match /routes/{routeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Stops Collection
    match /stops/{stopId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Settings Collection (keeps inviteCode private to Admins)
    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
